+/// A flag the host page can set on `window` before the engine starts (the HarmonyOS shell does,
+/// because a `resource://rawfile` page cannot rewrite its own query string): `__VC_WEBGL = "1"`
+/// forces the WebGL2 backend, `__VC_LANG = "zh-hans"` stands in for `?lang=`.
+fn js_flag(name: &str) -> Option<String> {
+    let window = web_sys::window()?;
+    let v = js_sys::Reflect::get(&window, &wasm_bindgen::JsValue::from_str(name)).ok()?;
+    v.as_string().filter(|s| !s.is_empty())
+}
