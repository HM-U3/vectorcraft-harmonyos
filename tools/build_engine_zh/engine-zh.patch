diff --git a/crates/ui-egui/src/theme.rs b/crates/ui-egui/src/theme.rs
index bff6ff8..ce66ad1 100644
--- a/crates/ui-egui/src/theme.rs
+++ b/crates/ui-egui/src/theme.rs
@@ -517,6 +517,38 @@ pub fn install_fonts(ctx: &egui::Context) {
     fonts.families.insert(FontFamily::Name(FONT_UI.into()), family(ui, &fallback));
     fonts.families.insert(FontFamily::Name(FONT_MONO.into()), family(mono, &mono_fallback));
     add_craft_fonts(&mut fonts);
+    // HarmonyOS 中文化：内嵌 Noto Sans SC 子集（CJK 字形），追加到所有字族末尾。
+    // 原生构建读不到系统 CJK 字体时（宿主另会再挂系统字体链），界面中文靠它兜底。
+    fonts.font_data.insert("NotoSansSC".to_owned(), Arc::new(FontData::from_static(include_bytes!("../../../assets/fonts/NotoSansSC-Subset.ttf"))));
+    for (_family, stack) in fonts.families.iter_mut() {
+        if !stack.iter().any(|f| f == "NotoSansSC") {
+            stack.push("NotoSansSC".to_string());
+        }
+    }
+    // HarmonyOS：系统自带的 HarmonyOS Sans SC（约 20 MB，覆盖 GB18030）接在子集**之后**作兜底。
+    // 内嵌子集只覆盖界面词条与源码字面量（约四千多字），用户在文字图层里输入生僻字
+    // （「龘」「犇」「𠮷」这类）时子集会缺字形、画布上直接空白 —— 画布上的文字正是用
+    // egui 的 galley 绘制的，所以必须把全字库挂到同一个字体栈里，光在 text crate 的
+    // fontdb 里兜底只够导出，不够屏幕预览。
+    // 子集有字时仍走子集（字形风格统一、包体小），只有缺字才落到系统字库。
+    #[cfg(target_env = "ohos")]
+    {
+        for path in ["/system/fonts/HarmonyOS_Sans_SC.ttf", "/system/fonts/HarmonyOS_Sans_TC.ttf"] {
+            let Ok(bytes) = std::fs::read(path) else { continue };
+            let Some(stem) = std::path::Path::new(path).file_stem().map(|s| s.to_string_lossy().into_owned()) else {
+                continue;
+            };
+            if fonts.font_data.contains_key(&stem) {
+                continue;
+            }
+            fonts.font_data.insert(stem.clone(), Arc::new(FontData::from_owned(bytes)));
+            for (_family, stack) in fonts.families.iter_mut() {
+                if !stack.iter().any(|f| f == &stem) {
+                    stack.push(stem.clone());
+                }
+            }
+        }
+    }
     ctx.set_fonts(fonts);
 }
 
